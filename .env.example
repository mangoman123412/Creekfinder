# Copy to .env (never commit .env). All EXPO_PUBLIC_* values are embedded in the app binary,
# so only put PUBLIC / publishable keys here. See docs/SETUP.md for how to obtain each.

# Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# MapTiler Cloud: Account -> API keys  (satellite, topo/trails, streets, search)
EXPO_PUBLIC_MAPTILER_KEY=YOUR-MAPTILER-KEY

# RevenueCat: Project -> API keys -> "Public app-specific API key" (one per platform)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Public URLs (required by the stores). Host your policy pages and put the URLs here.
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
